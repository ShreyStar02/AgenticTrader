# AgenticTrader backend config — copy to .env and fill secrets (paper trading only)
ENVIRONMENT=dev
FUNDS_PASSWORD=trade123
SCAN_INTERVAL_MINUTES=15
AUTONOMOUS_ENABLED=true
DEFAULT_RISK_PROFILE=moderate

# ---- LLM provider (swap easily) ----
# Options: nvidia | huggingface | openai | none
LLM_PROVIDER=nvidia
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_ENABLED=true

# NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# HuggingFace (only used if LLM_PROVIDER=huggingface)
HF_API_KEY=
HF_BASE_URL=https://api-inference.huggingface.co/models

# Generic OpenAI-compatible (only used if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Optional: Telegram push alerts (free) ----
# Create a bot via @BotFather, then get your chat id from @userinfobot.
# Leave blank to disable. In the cloud, set these as GitHub Actions secrets instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Optional: unattended/cloud runs ----
# On a brand-new DB with no prior deposits, seed this amount once (0 = disabled).
INITIAL_FUNDS=0

